---
// Home hero, redesigned 19 Sep 2026.
// The hero starts EMPTY. The headline types itself out, "We Help Businesses," then
// "Do More With Less." on two lines. It holds, then the sub line types itself out
// underneath and is kept for good. The headline then wipes once and types
// "Get It Sorted," "With Sortoise.", and the whole hero comes to rest there.
// One cycle, then it stops. Nothing loops for ever.
// Everything is Deep Teal 700, the caret is Pink 500 and follows whatever is typing.
// No eyebrow, no button, no underliner.
// If the visitor has asked their device for less motion, the first phrase and the
// full sub line simply sit there, with no typing and no caret.
---

<section class="hero">
  <div class="hero-inner">
    <h1 class="typed" aria-label="We Help Businesses, Do More With Less. Get It Sorted, With Sortoise."
      ><span class="txt"><span class="out" aria-hidden="true"></span><span class="caret caret-h" aria-hidden="true"></span></span></h1>
    <p class="sub">
      <span class="sr-only">Custom software that sorts your workflow and takes the day-to-day tasks off your team.</span>
      <span class="sub-ghost" aria-hidden="true">Custom software that sorts your workflow and takes the day-to-day tasks off your team.</span>
      <span class="sub-live" aria-hidden="true"><span class="sub-out"></span><span class="caret caret-s" hidden></span></span>
    </p>
  </div>
</section>

<style>
  .hero {
    background: transparent;
    box-sizing: border-box;
    min-height: clamp(440px, 72vh, 760px);
    padding: 24px 24px 104px;
    display: grid;
    place-items: center;
    text-align: center;
    font-family: var(--font-body);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    max-width: var(--container-max);
  }
  .typed {
    margin: 0;
    font-size: clamp(34px, 7.2vw, 66px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--deep-700);
    white-space: pre-wrap;
    /* Room for two lines, so nothing jumps while the words type in and out. */
    min-height: 2.1em;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* The sub keeps a hidden copy of itself at full length, so the hero reserves the
     right height from the start and nothing shifts as the words arrive. */
  .sub {
    position: relative;
    margin: 0;
    max-width: 560px;
    font-size: var(--text-lead);
    line-height: var(--leading-body);
    color: var(--ground-text-soft, var(--stone-700));
  }
  .sub-ghost { visibility: hidden; }
  .sub-live { position: absolute; inset: 0; }
  /* The full sentence for screen readers, since the visible copy is typed a letter
     at a time and the sizing copy is hidden from them. */
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
  .caret {
    display: inline-block;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.04em;
    vertical-align: -0.08em;
    background: var(--pink-500);
    animation: blink 1s steps(2) infinite;
  }
  .caret[hidden] { display: none; }
  @keyframes blink { to { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .caret { display: none; }
  }
  @media (max-width: 820px) {
    .hero { min-height: clamp(360px, 60vh, 600px); padding: 16px 20px 72px; }
    .hero-inner { gap: 20px; }
    .sub { font-size: 17px; max-width: 100%; }
  }
</style>

<script>
  // Types the headline, then the sub line, then settles. The per letter pace is
  // 1.4x slower than the first build of this hero. The pauses where a phrase is
  // held still were not slowed, only the typing itself.
  const out = document.querySelector<HTMLElement>(".hero .out");
  const subOut = document.querySelector<HTMLElement>(".hero .sub-out");
  const caretH = document.querySelector<HTMLElement>(".hero .caret-h");
  const caretS = document.querySelector<HTMLElement>(".hero .caret-s");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const first = ["We Help Businesses,", "Do More With Less."];
  const second = ["Get It Sorted,", "With Sortoise."];
  const sub = "Custom software that sorts your workflow and takes the day-to-day tasks off your team.";

  if (out && subOut) {
    if (reduce) {
      out.textContent = first.join("\n");
      subOut.textContent = sub;
    } else {
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

      // Which line the caret sits on. "none" once the hero has come to rest.
      const caretOn = (which: "h" | "s" | "none") => {
        if (caretH) caretH.hidden = which !== "h";
        if (caretS) caretS.hidden = which !== "s";
      };

      const type = async (el: HTMLElement, lines: string[], perChar: number) => {
        el.textContent = "";
        for (let i = 0; i < lines.length; i++) {
          for (const ch of lines[i]) {
            el.textContent += ch;
            await sleep(perChar);
          }
          if (i < lines.length - 1) {
            el.textContent += "\n";
            await sleep(220);
          }
        }
      };

      const wipe = async () => {
        while (out.textContent && out.textContent.length) {
          out.textContent = out.textContent.slice(0, -1);
          await sleep(25);
        }
      };

      const run = async () => {
        caretOn("h");
        await sleep(500);
        await type(out, first, 133);
        await sleep(500);

        caretOn("s");
        await type(subOut, [sub], 36);
        await sleep(1600);

        caretOn("h");
        await wipe();
        await sleep(300);
        await type(out, second, 98);

        // Rest here. The sub line stays, the headline stays, the caret goes.
        caretOn("none");
      };
      run();
    }
  }
</script>
