---
// Home hero, redesigned 19 Sep 2026.
//
// The hero starts EMPTY and plays one sequence, then stops for good:
//   1. the headline types itself, "We Help Businesses," / "Do More With Less.", and holds
//   2. the sub line types underneath it and holds
//   3. five stars pop in one at a time
//   4. "A five star service" types under them
//   5. the way down fades in at the foot of the screen
// Nothing wipes and nothing loops. "Get It Sorted, With Sortoise." is deliberately not
// in the hero, Aaron's call on 19 Sep.
//
// Everything is Deep Teal 700 except the stars, which are Amber 500, and the caret,
// which is Pink 500 and follows whatever is typing.
// No eyebrow and no button.
// If the visitor has asked their device for less motion, the finished hero is simply
// there: headline, sub, five stars and the line, with no typing and no caret.
//
// Height: the hero takes whatever is left of the first screen once the nav above it
// has had its share. The nav costs 88px on desktop (20px above it, then a 68px bar)
// and 76px on phone.
// It measures in svh, not vh. On a phone, 100vh is the height the screen would have
// with the browser's address bar hidden, which is taller than what you can actually
// see on load, so the hero ran off the bottom of the screen, the content sat low and
// the way down was pushed out of sight. svh is the smaller, always visible height.
// The plain vh line above each one is the fallback for browsers that predate svh.
const stars = [0, 1, 2, 3, 4];
---

<section class="hero">
  <div class="hero-inner">
    <h1 class="typed" aria-label="We Help Businesses, Do More With Less."
      ><span class="txt"><span class="out" aria-hidden="true"></span><span class="caret caret-h" aria-hidden="true"></span></span></h1>

    <p class="sub">
      <span class="sr-only">Custom software that sorts your workflow and takes the day-to-day tasks off your team.</span>
      <span class="sub-ghost" aria-hidden="true">Custom software that sorts your workflow and takes the day-to-day tasks off your team.</span>
      <span class="sub-live" aria-hidden="true"><span class="sub-out"></span><span class="caret caret-s" hidden></span></span>
    </p>

    <div class="proof">
      <div class="stars" aria-hidden="true">
        {stars.map(() => (
          <svg class="star" viewBox="0 0 24 24"><path fill="#e07a2f" d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path></svg>
        ))}
      </div>
      <p class="five">
        <span class="sr-only">A five star service</span>
        <span class="five-ghost" aria-hidden="true">A five star service</span>
        <span class="five-live" aria-hidden="true"><span class="five-out"></span><span class="caret caret-f" hidden></span></span>
      </p>
    </div>
  </div>

  <div class="cue">
    <a href="#video">
      <span class="label">See how it works</span>
      <svg class="chev" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: transparent;
    box-sizing: border-box;
    min-height: max(440px, calc(100vh - 88px));
    min-height: max(440px, calc(100svh - 88px));
    padding: 24px 24px 104px;
    display: grid;
    place-items: center;
    text-align: center;
    font-family: var(--font-body);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    max-width: var(--container-max);
  }
  .typed {
    margin: 0;
    font-size: clamp(34px, 7.2vw, 66px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--deep-700);
    white-space: pre-wrap;
    /* Room for two lines, so nothing jumps while the words type in. */
    min-height: 2.1em;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* The sub and the five star line each keep a hidden copy of themselves at full
     length, so the hero reserves the right height from the start and nothing shifts
     as the words arrive. */
  .sub {
    position: relative;
    margin: 0;
    max-width: 560px;
    font-size: var(--text-lead);
    line-height: var(--leading-body);
    color: var(--ground-text-soft, var(--stone-700));
  }
  .sub-ghost, .five-ghost { visibility: hidden; }
  .sub-live, .five-live { position: absolute; inset: 0; }

  /* Five stars, then the line under them. The stars hold their space from the start
     too, so only their opacity and scale change. Amber 500 is the palette's one warm
     accent that is not already spoken for: pink is the caret and the nav pill. */
  .proof { display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .stars { display: flex; gap: 8px; height: 30px; }
  .star { width: 30px; height: 30px; display: block; opacity: 0; transform: scale(.4); }
  .star.lit { animation: pop 420ms var(--ease-out) forwards; }
  @keyframes pop {
    0%   { opacity: 0; transform: scale(.4); }
    60%  { opacity: 1; transform: scale(1.14); }
    100% { opacity: 1; transform: scale(1); }
  }
  .five {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ground-text, var(--deep-700));
  }

  /* The way down. It sits in the hero's bottom padding, at the edge of the screen,
     so it reads as a signpost rather than one more line of the hero. */
  .cue {
    position: absolute;
    left: 0; right: 0; bottom: 34px;
    display: flex;
    justify-content: center;
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }
  .cue.shown { opacity: 1; }
  .cue a {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--deep-600);
  }
  .cue .label {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 400;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: rgba(14, 104, 93, .35);
  }
  .cue a:hover .label { text-decoration-color: currentColor; }
  .cue .chev { animation: bob 2.2s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  /* The full sentence for screen readers, since the visible copy is typed a letter
     at a time and the sizing copy is hidden from them. */
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0 0 0 0); clip-path: inset(50%); white-space: nowrap;
  }
  .caret {
    display: inline-block;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.04em;
    vertical-align: -0.08em;
    background: var(--pink-500);
    animation: blink 1s steps(2) infinite;
  }
  .caret[hidden] { display: none; }
  @keyframes blink { to { opacity: 0; } }

  @media (prefers-reduced-motion: reduce) {
    .caret { display: none; }
    .star { opacity: 1; transform: none; }
    .star.lit { animation: none; }
    .cue .chev { animation: none; }
    .cue { transition: none; }
  }

  @media (max-width: 820px) {
    .hero {
      min-height: max(360px, calc(100vh - 76px));
      min-height: max(360px, calc(100svh - 76px));
      padding: 16px 20px 72px;
    }
    .hero-inner { gap: 20px; }
    .sub { font-size: 17px; max-width: 100%; }
    .stars { height: 24px; gap: 6px; }
    .star { width: 24px; height: 24px; }
    .five { font-size: 17px; }
    .cue { bottom: 22px; }
    .cue .label { font-size: 13px; }
  }
</style>

<script>
  // One pass, then it rests. The per letter pace is 1.4x slower than the first build
  // of this hero; the pauses where something is held were not slowed with it.
  const out = document.querySelector<HTMLElement>(".hero .out");
  const subOut = document.querySelector<HTMLElement>(".hero .sub-out");
  const fiveOut = document.querySelector<HTMLElement>(".hero .five-out");
  const caretH = document.querySelector<HTMLElement>(".hero .caret-h");
  const caretS = document.querySelector<HTMLElement>(".hero .caret-s");
  const caretF = document.querySelector<HTMLElement>(".hero .caret-f");
  const cue = document.querySelector<HTMLElement>(".hero .cue");
  const starEls = Array.from(document.querySelectorAll<HTMLElement>(".hero .star"));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const headline = ["We Help Businesses,", "Do More With Less."];
  const sub = "Custom software that sorts your workflow and takes the day-to-day tasks off your team.";
  const five = "A five star service";

  if (out && subOut && fiveOut) {
    if (reduce) {
      out.textContent = headline.join("\n");
      subOut.textContent = sub;
      fiveOut.textContent = five;
      starEls.forEach((el) => el.classList.add("lit"));
      cue?.classList.add("shown");
    } else {
      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

      // Which line the caret sits on. "none" once the hero has come to rest.
      const caretOn = (which: "h" | "s" | "f" | "none") => {
        if (caretH) caretH.hidden = which !== "h";
        if (caretS) caretS.hidden = which !== "s";
        if (caretF) caretF.hidden = which !== "f";
      };

      const type = async (el: HTMLElement, lines: string[], perChar: number) => {
        el.textContent = "";
        for (let i = 0; i < lines.length; i++) {
          for (const ch of lines[i]) {
            el.textContent += ch;
            await sleep(perChar);
          }
          if (i < lines.length - 1) {
            el.textContent += "\n";
            await sleep(220);
          }
        }
      };

      const run = async () => {
        caretOn("h");
        await sleep(500);
        await type(out, headline, 133);
        await sleep(900);

        caretOn("s");
        await type(subOut, [sub], 36);
        await sleep(1200);

        // Stars, one at a time.
        caretOn("none");
        for (const el of starEls) {
          el.classList.add("lit");
          await sleep(150);
        }
        await sleep(400);

        caretOn("f");
        await type(fiveOut, [five], 84);
        await sleep(500);

        // Rest here. Everything stays, the caret goes, the way down arrives.
        caretOn("none");
        cue?.classList.add("shown");
      };
      run();
    }
  }
</script>
