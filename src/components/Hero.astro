---
// Home hero, redesigned 19 Sep 2026. One centred headline that types itself out and loops:
// "Do more" "With Less" on two lines, a pause, wiped, then "Get It Sorted," "With Sortoise.",
// a pause, wiped, and round again. No eyebrow, no button, no underliner (Aaron removed them).
// If the visitor has asked their device for less motion, the two lines simply sit there.
---

<section class="hero">
  <h1 class="typed" aria-label="Do more with less. Get It Sorted, With Sortoise."
    ><span class="out" aria-hidden="true">Do more
With Less</span><span class="caret" aria-hidden="true"></span></h1>
</section>

<style>
  .hero {
    background: transparent;
    padding: 88px 24px 104px;
    text-align: center;
    font-family: var(--font-body);
  }
  .typed {
    max-width: var(--container-max);
    margin: 0 auto;
    font-size: clamp(44px, 7.2vw, 96px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--deep-700);
    white-space: pre-wrap;
    /* Room for two lines, so the page does not jump while the words type in and out. */
    min-height: 2.1em;
  }
  .caret {
    display: inline-block;
    width: 0.06em;
    height: 0.9em;
    margin-left: 0.04em;
    vertical-align: -0.08em;
    background: var(--pink-500);
    animation: blink 1s steps(2) infinite;
  }
  @keyframes blink { to { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .caret { display: none; }
  }
  @media (max-width: 820px) {
    .hero { padding: 56px 20px 72px; }
  }
</style>

<script>
  // Types the headline out letter by letter, on a loop.
  const out = document.querySelector<HTMLElement>(".hero .out");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (out && !reduce) {
    const first = ["Do more", "With Less"];
    const second = ["Get It Sorted,", "With Sortoise."];
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const type = async (lines: string[], perChar: number) => {
      out.textContent = "";
      for (let i = 0; i < lines.length; i++) {
        for (const ch of lines[i]) {
          out.textContent += ch;
          await sleep(perChar);
        }
        if (i < lines.length - 1) {
          out.textContent += "\n";
          await sleep(220);
        }
      }
    };

    const wipe = async () => {
      while (out.textContent && out.textContent.length) {
        out.textContent = out.textContent.slice(0, -1);
        await sleep(18);
      }
    };

    const loop = async () => {
      // The page loads with the two lines already showing, so wipe those first.
      await sleep(1800);
      await wipe();
      while (true) {
        await sleep(300);
        await type(second, 70);
        await sleep(2200);
        await wipe();
        await sleep(400);
        await type(first, 95);
        await sleep(1800);
        await wipe();
      }
    };
    loop();
  }
</script>
