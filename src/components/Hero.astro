---
// Home hero, locked 18 Sep 2026. Split layout: eyebrow and headline left,
// sub, CTA and underliner right, bottom-aligned. Collapses to one column under 820px.
// Copy and colours match the Hero board on the Sortoise Home canvas. Do not change without Aaron.
interface Props {
  eyebrow?: string;
  headline?: string;
  sub?: string;
  cta?: { label: string; href: string };
  note?: string;
  noteHref?: string;
}

const {
  eyebrow = "CUSTOM SYSTEMS",
  headline = "Helping businesses do more with less",
  sub = "Custom software that sorts your workflow and takes the day-to-day tasks off your team.",
  cta = { label: "Get It Sorted", href: "#" },
  note = "Not ready? See what we've built",
  noteHref = "#case-study",
} = Astro.props;
---

<section class="hero">
  <div class="split">
    <div class="top">
      <div class="eyebrow hero-eyebrow">{eyebrow}</div>
      <h1>{headline}</h1>
    </div>
    <div class="bottom">
      <p class="sub">{sub}</p>
      <div class="actions">
        <a href={cta.href} class="cta">{cta.label}</a>
      </div>
      <p class="note"><a href={noteHref}>{note}</a></p>
    </div>
  </div>
</section>

<style>
  .hero {
    background: transparent;
    padding: 88px 24px 104px;
    text-align: left;
    font-family: var(--font-body);
  }
  .split {
    max-width: var(--container-max);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px 64px;
    align-items: end;
  }
  .hero-eyebrow { margin-bottom: 0; color: var(--teal-600); }
  h1 {
    font-size: var(--text-hero);
    margin: 16px 0 0;
    text-wrap: balance;
  }
  .bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-bottom: 6px;
  }
  .sub {
    font-size: var(--text-lead);
    color: var(--text-soft);
    max-width: 600px;
    margin: 0;
    text-wrap: pretty;
  }
  .actions {
    display: flex; flex-wrap: wrap; gap: 12px;
    justify-content: flex-start;
    margin-top: 28px;
  }
  .cta {
    display: inline-flex; align-items: center;
    padding: 14px 30px;
    border-radius: var(--radius-pill);
    background: var(--pink-500);
    color: var(--deep-950);
    font-family: var(--font-display);
    font-weight: 700; font-size: 16px;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .cta:hover { background: var(--pink-400); color: var(--deep-950); }
  .note {
    font-size: var(--text-sm);
    color: var(--text-faint);
    margin: 18px 0 0;
  }
  .note a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--text-link);
  }
  @media (max-width: 820px) {
    .hero { padding: 56px 20px 72px; }
    .split { grid-template-columns: minmax(0, 1fr); gap: 24px; }
  }
</style>
