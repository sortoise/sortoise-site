---
// Home hero, rebuilt 20 Sep 2026. Everything is simply there when the page loads.
//
// In order: the headline, the sub line, five stars and "A five star service" sharing
// one row, the Powered by reel, and the way down to the video at the foot of the
// screen. No typing, no caret, no Get It Sorted button.
//
// The typewriter went because it put the proof and the reel twenty seconds down the
// road, so anyone who scrolled early never saw them. The only movement left is the
// reel and the small bob on the chevron.
//
// The reel is the same one that sits at the foot of the Services card, though that
// one is still labelled "Powered by" and this one reads "We Connect With", and is built
// the same way, two identical runs sliding half a width so the loop has no seam. It
// runs the full 1120px content cap, which is exactly the width of the nav bar above
// it (1240px wrap less its 60px sides). Aaron's call.
// NOTE: this does not remove the reel from Services, so it is on Home twice until
// that section's own chat takes it out.
//
// Height: the hero takes whatever is left of the first screen once the nav above it
// has had its share, 88px on desktop and 76px on phone. It measures in svh, not vh,
// because on a phone 100vh is the height the screen would have with the address bar
// hidden, which is taller than what you can see on arrival.

// Logo files live in public/logos. "mark" logos are square icons, "word" logos are
// wordmarks, so they get different heights and read as the same size.
const logos = [
  { name: "Supabase", file: "supabase.png", kind: "mark" },
  { name: "Firebase", file: "firebase.png", kind: "mark" },
  { name: "Zapier", file: "zapier.png", kind: "mark" },
  { name: "n8n", file: "n8n.png", kind: "word" },
  { name: "Make", file: "make.png", kind: "word" },
  { name: "GitHub", file: "github.png", kind: "mark" },
  { name: "Stripe", file: "stripe.png", kind: "word" },
  { name: "Twilio", file: "twilio.png", kind: "word" },
  { name: "Google Drive", file: "google-drive.png", kind: "mark" },
  { name: "Google Calendar", file: "google-calendar.png", kind: "word" },
  { name: "Calendly", file: "calendly.png", kind: "word" },
  { name: "Microsoft Teams", file: "microsoft-teams.png", kind: "mark" },
  { name: "Xero", file: "xero.png", kind: "mark" },
  { name: "VS Code", file: "vs-code.png", kind: "mark" },
];

const stars = [0, 1, 2, 3, 4];
const star = "M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z";
---

<section class="hero">
  <div class="hero-inner">
    <h1 class="headline">We Help Businesses,
Do More With Less.</h1>

    <p class="sub">Custom software that sorts your workflow and takes the day-to-day tasks off your team.</p>

    <div class="proof">
      <div class="stars" aria-hidden="true">
        {stars.map(() => (
          <svg class="star" viewBox="0 0 24 24"><path fill="#e07a2f" d={star}></path></svg>
        ))}
      </div>
      <span class="five">A five star service</span>
    </div>

    <div class="powered">
      <div class="eyebrow">We Connect With</div>
      <div class="reel" aria-label="Platforms we build with">
        <div class="track">
          <div class="run">
            {logos.map((l) => (
              <div class="logo"><img src={`/logos/${l.file}`} alt={l.name} class={l.kind} /></div>
            ))}
          </div>
          <div class="run" aria-hidden="true">
            {logos.map((l) => (
              <div class="logo"><img src={`/logos/${l.file}`} alt="" class={l.kind} /></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="cue">
    <a href="#video">
      <span class="label">See how it works</span>
      <svg class="chev" width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: transparent;
    box-sizing: border-box;
    min-height: max(440px, calc(100vh - 88px));
    min-height: max(440px, calc(100svh - 88px));
    padding: 24px 24px 104px;
    display: grid;
    /* The column must be allowed to shrink. Without this it sizes itself to its
       widest content, and the reel's track is deliberately max-content wide so the
       marquee can run, which dragged the whole hero out to 1120px and centred that
       in a 390px phone. Everything ended up off the side of the screen. */
    grid-template-columns: minmax(0, 1fr);
    place-items: center;
    text-align: center;
    font-family: var(--font-body);
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    width: 100%;
    min-width: 0;
    max-width: var(--container-max);
  }
  .headline {
    margin: 0;
    font-size: clamp(34px, 7.2vw, 66px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--deep-700);
    /* The line break in the markup is the break on screen. */
    white-space: pre-line;
  }
  .sub {
    margin: 0;
    max-width: 560px;
    font-size: var(--text-lead);
    line-height: var(--leading-body);
    color: var(--ground-text-soft, var(--stone-700));
  }

  /* Stars and their line share one row. The stars are 26px so they sit beside
     19px text rather than towering over it. */
  .proof { display: flex; align-items: center; justify-content: center; gap: 12px; }
  .stars { display: flex; gap: 6px; }
  .star { width: 26px; height: 26px; display: block; }
  .five {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ground-text, var(--deep-700));
    white-space: nowrap;
  }

  /* The Powered by reel, the same build as the one in Services.astro. Each run
     carries its own trailing gap so the two runs are exactly the same width and
     sliding half way left lands on the start of the second with no seam. */
  /* min-width: 0 on both, so the track's max-content width stays inside the reel
     instead of pushing its parents wider than the screen. */
  .powered { display: flex; flex-direction: column; align-items: center; gap: 18px; width: 100%; min-width: 0; }
  .reel { position: relative; overflow: hidden; width: 100%; min-width: 0; }
  /* Fade at both edges so the logos slide in and out rather than cut off. */
  .reel::before, .reel::after {
    content: ""; position: absolute; top: 0; bottom: 0; width: 80px; z-index: 1; pointer-events: none;
  }
  .reel::before { left: 0; background: linear-gradient(90deg, var(--paper-200), rgba(250, 245, 224, 0)); }
  .reel::after { right: 0; background: linear-gradient(270deg, var(--paper-200), rgba(250, 245, 224, 0)); }
  .track { display: flex; width: max-content; animation: reel 45s linear infinite; }
  .run { display: flex; gap: 56px; padding-right: 56px; flex-shrink: 0; }
  @keyframes reel { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .logo { flex-shrink: 0; display: flex; align-items: center; justify-content: center; height: 44px; }
  .logo img { width: auto; display: block; }
  .logo img.mark { height: 36px; }
  .logo img.word { height: 26px; }

  /* The way down. It sits in the hero's bottom padding, at the edge of the screen,
     so it reads as a signpost rather than one more line of the hero. */
  .cue {
    position: absolute;
    left: 0; right: 0; bottom: 34px;
    display: flex;
    justify-content: center;
  }
  .cue a {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--deep-600);
  }
  .cue .label {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 400;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: rgba(14, 104, 93, .35);
  }
  .cue a:hover .label { text-decoration-color: currentColor; }
  .cue .chev { animation: bob 2.2s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  @media (prefers-reduced-motion: reduce) {
    .track, .cue .chev { animation: none; }
  }

  @media (max-width: 820px) {
    /* 16px sides, the same gutter as the nav wrap, so the reel lines up with the bar. */
    .hero {
      min-height: max(360px, calc(100vh - 76px));
      min-height: max(360px, calc(100svh - 76px));
      padding: 16px 16px 72px;
    }
    .hero-inner { gap: 20px; }
    .sub { font-size: 17px; max-width: 100%; }
    .star { width: 20px; height: 20px; }
    .stars { gap: 4px; }
    .five { font-size: 16px; }
    .powered { gap: 14px; }
    .reel::before, .reel::after { width: 40px; }
    .run { gap: 36px; padding-right: 36px; }
    .logo { height: 40px; }
    .logo img.mark { height: 30px; }
    .logo img.word { height: 22px; }
    .cue { bottom: 22px; }
    .cue .label { font-size: 13px; }
  }
</style>

<script>
  // Start at the top of the page.
  // Browsers remember where you were and put you back there when you return or
  // reload, which drops a returning visitor into the middle of the page.
  // Going back or forward is left alone, because there the remembered position is
  // the whole point, and a link with a #target on it is left alone too.
  {
    const entry = performance.getEntriesByType("navigation")[0] as PerformanceNavigationTiming | undefined;
    const backOrForward = entry?.type === "back_forward";
    if (!backOrForward && !location.hash) {
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      // "instant" so it does not fight the smooth scrolling set in global.css.
      const toTop = () => window.scrollTo({ top: 0, left: 0, behavior: "instant" as ScrollBehavior });
      toTop();
      window.addEventListener("load", toTop, { once: true });
    }
  }
</script>
