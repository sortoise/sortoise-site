---
// Services page picker, built 11 Oct 2026 from the "B. Pick a service" board on the Sortoise Services canvas.
// One card on the off grey. The four services and "Something else?" sit as tabs across the top, and
// the panel underneath swaps when a tab is chosen. Each service panel has a headline, a short
// paragraph, the four things it covers, a white box with the client we built it for and their own
// words, then a question and the amber Get It Sorted button.
// A link such as /services#custom-crms opens the page on that service.
//
// The four service names and the four pointer titles under each are the locked Home tile copy.
// Every client line comes from the two case studies, and every quote is the client's own, taken
// from their review on Home. There are no numbers for Steve, so none are quoted. Do not add facts
// or change the quotes without Aaron.
// To change the wording, edit the lists below. Nothing else needs touching.

// Every Get It Sorted opens the quiz page, which also holds the plain enquiry form.
const ctaHref = "/quiz";

const clients: Record<string, { name: string; trade: string; logo: string; logoW: number; logoH: number; said: string; href: string }> = {
  dwj: {
    name: "D W Jenkins",
    trade: "Building contractor, Llanelli",
    logo: "/logos/clients/d-w-jenkins.png",
    logoW: 192,
    logoH: 192,
    said: "Wayne, D W Jenkins",
    href: "/case-study#d-w-jenkins",
  },
  cwe: {
    name: "Cavity Wall Extraction UK",
    trade: "Surveys and extraction",
    logo: "/logos/clients/cavity-wall-extraction-uk.png",
    logoW: 549,
    logoH: 385,
    said: "Steve, Cavity Wall Extraction UK",
    href: "/case-study#cavity-wall-extraction-uk",
  },
};

const services = [
  {
    id: "custom-software",
    name: "Custom software and web apps",
    icon: "software",
    headline: "One tool for the job that eats your week.",
    lead: "If a job's spread across spreadsheets, paper and your own memory, we build one tool that holds all of it. It's built around the way you already work, so you're not changing how you do things to suit the software.",
    points: [
      { title: "Quoting, proposals and invoicing", text: "Quotes and proposals go out from one screen, and the invoice is ready as soon as the work's done." },
      { title: "Data pulled between your platforms", text: "Your systems pass information to each other, so nobody types the same details in twice." },
      { title: "Formatting and storage in one place", text: "Everything's kept in one place, laid out the way you actually need it." },
      { title: "Manual admin hours taken out", text: "You get back the hours that go on copying things over, checking and chasing." },
    ],
    client: "dwj",
    built: "Wayne's site app feeds a desktop app that turns the invoice, the health and safety document and the photo evidence into one pack at the click of a button.",
    quote: "It's saved us a lot of time, cut out the mistakes, and I finally have a clear view of what's been done and what's been billed.",
    ctaLine: "Got a job that still runs on spreadsheets and paper?",
  },
  {
    id: "custom-crms",
    name: "Custom CRMs",
    icon: "crm",
    headline: "A CRM built around the way you sell.",
    lead: "An off-the-shelf CRM can leave you with tabs you never use and all the chasing still to do by hand. We build yours around how you actually sell, so leads get answered, booked in and followed up without you having to remember.",
    points: [
      { title: "Text and email follow-up", text: "New leads hear from you straight away, and the reminders and chasers go out on their own." },
      { title: "Calendar booking and reminders", text: "Appointments go straight into your calendar, and the customer gets a reminder before you arrive." },
      { title: "Pipelines and customer journeys", text: "You can see where every sale sits, and each lead moves on as the work gets done." },
      { title: "Existing customers kept warm", text: "Past customers keep hearing from you, so repeat work doesn't rely on your memory." },
    ],
    client: "cwe",
    built: "Steve's form leads and missed calls land in one inbox, new leads get a text telling them to expect a call, and proposals are sent and chased from the CRM until they're signed.",
    quote: "Our leads land in the CRM, email and text reminders are sent from within the CRM just by clicking a button, and customers are chased automatically.",
    ctaLine: "Leads slipping through the cracks in your business?",
  },
  {
    id: "admin-automation",
    name: "Business admin and process automation",
    icon: "admin",
    headline: "The weekly admin, done without you.",
    lead: "Some jobs follow the same steps every week and still eat hours, because somebody has to sit down and do them. We turn those steps into a tool that does the job for you and keeps the paperwork in order as it goes.",
    points: [
      { title: "Repetitive admin done for you", text: "The jobs you do the same way every week get done without you sitting down to them." },
      { title: "Complex tasks handled by logic", text: "If a job can go more than one way, the tool follows your rules to get to the right answer." },
      { title: "Documents created for you", text: "Answer a few questions and the document's written, laid out and saved." },
      { title: "Compliance paperwork in order", text: "Every record's kept against its job, ready for when someone asks to see it." },
    ],
    client: "dwj",
    built: "Wayne answers a short Q&A and the site-specific health and safety document is written for him, and his invoices are created with the right rates and VAT already applied.",
    quote: "I'd recommend them to any small business that's drowning in admin.",
    ctaLine: "Doing the same paperwork every single week?",
  },
  {
    id: "mobile-apps",
    name: "Mobile apps for the field",
    icon: "mobile",
    headline: "Get the paperwork done before you leave site.",
    lead: "When the work's away from the desk, the paperwork usually waits till the end of the day. We build apps your team uses on site, so what they put in goes straight into your system and the office is up to date before they're back.",
    points: [
      { title: "Apps for the people on site", text: "Your team records the job on their phone while they're still there." },
      { title: "Straight into your database", text: "What they enter lands in your system as they go, with nothing to type up later." },
      { title: "Missed calls into the CRM", text: "A missed call to your work phone becomes a lead you can follow up." },
      { title: "Reporting and analytics on top", text: "You get a clear view of what's been done and what's been billed." },
    ],
    client: "cwe",
    built: "Steve records his survey findings and meterage in an app on site, which moves the lead on and tells the customer a proposal is coming.",
    quote: "The CRM connects with a mobile app the lads built where I can do my surveys.",
    ctaLine: "Still writing up site notes back at the office?",
  },
];

// The fifth tab, for a job that is not one of the four. The lead is the locked line from Home.
const other = {
  id: "something-else",
  name: "Something else?",
  icon: "other",
  headline: "Got a job that isn't on the list?",
  lead: "If none of these look like your business, don't panic. If there's a task that eats your time, we can almost certainly build a tool to save it.",
  jobs: [
    "Counting items and quantities at every job address",
    "Writing a health and safety document for each site",
    "Putting an invoice pack together for the contractor",
    "Texting new leads to tell them to expect a call",
    "Adding missed calls to the lead list",
    "Chasing proposals that haven't been signed",
  ],
  ctaLine: "Tell us the job that eats your week.",
};

const tabs = [...services, other];

// The same line icons as the Home tiles, plus a plus sign for "Something else?".
const icons: Record<string, string> = {
  software:
    '<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v11a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 17.5v-11z"/><path d="M4 9h16"/><path d="M9.5 13l-2 2 2 2"/><path d="M14.5 13l2 2-2 2"/>',
  crm: '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/><path d="M16 4.5a3.2 3.2 0 0 1 0 6.4"/><path d="M17.5 14.2c2 .6 3 2.4 3 4.8"/>',
  admin:
    '<path d="M7 3.5h7l4 4V19a1.5 1.5 0 0 1-1.5 1.5h-9.5A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5z"/><path d="M14 3.5V8h4"/><path d="M8.5 13.5l2.2 2.2 4.8-4.8"/>',
  mobile: '<rect x="7" y="2.5" width="10" height="19" rx="2.2"/><path d="M11 18.5h2"/><path d="M10.5 6h3"/>',
  other: '<path d="M12 5v14"/><path d="M5 12h14"/>',
};
---

<section class="picker" aria-label="What we build">
  <div class="card" data-picker>
    {tabs.map((t) => <span class="anchor" id={t.id}></span>)}

    <div class="tabs" role="tablist" aria-label="Choose a service">
      {tabs.map((t, i) => (
        <button
          type="button"
          class:list={["tab", { "tab-other": t.id === other.id }]}
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-tab={t.id}
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icons[t.icon]} /></svg>
          <span class="tab-label">{t.name}</span>
        </button>
      ))}
    </div>

    {services.map((s, i) => {
      const c = clients[s.client];
      return (
        <div
          class="panel"
          id={`panel-${s.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${s.id}`}
          data-panel={s.id}
          hidden={i !== 0}
        >
          <div class="split">
            <div class="main">
              <div class="intro">
                <h2><span class="sr-only">{s.name}: </span>{s.headline}</h2>
                <p class="lead">{s.lead}</p>
              </div>
              <div class="covers">
                <p class="label">What it covers</p>
                <ul class="points">
                  {s.points.map((p) => (
                    <li>
                      <span class="dot" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7" /></svg>
                      </span>
                      <span class="point">
                        <span class="point-title">{p.title}</span>
                        <span class="point-text">{p.text}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="client">
              <div class="client-top">
                <img src={c.logo} alt="" width={c.logoW} height={c.logoH} decoding="async" />
                <div class="client-id">
                  <span class="client-name">{c.name}</span>
                  <span class="client-trade">{c.trade}</span>
                </div>
              </div>
              <div class="rule"></div>
              <div class="client-block">
                <p class="label">What we built</p>
                <p class="built">{s.built}</p>
              </div>
              <figure class="quote">
                <blockquote>&ldquo;{s.quote}&rdquo;</blockquote>
                <figcaption>{c.said}</figcaption>
              </figure>
              <a class="see" href={c.href}>Read the full case study</a>
            </div>
          </div>

          <div class="cta">
            <p>{s.ctaLine}</p>
            <a class="pill" href={ctaHref}>Get It Sorted</a>
          </div>
        </div>
      );
    })}

    <div
      class="panel"
      id={`panel-${other.id}`}
      role="tabpanel"
      aria-labelledby={`tab-${other.id}`}
      data-panel={other.id}
      hidden
    >
      <div class="split">
        <div class="main">
          <div class="intro">
            <h2>{other.headline}</h2>
            <p class="lead">{other.lead}</p>
          </div>
          <div class="covers">
            <p class="label">Jobs we've already taken off someone's desk</p>
            <ul class="points jobs">
              {other.jobs.map((job) => (
                <li>
                  <span class="dot" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7" /></svg>
                  </span>
                  <span class="job">{job}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="client call">
          <div class="client-block">
            <p class="label">The discovery call</p>
            <p class="free">Completely free</p>
            <p class="built">It's a chance for us to understand your business and work out whether we can get it sorted.</p>
          </div>
          <div class="rule"></div>
          <div class="client-block">
            <p class="label">Who you talk to</p>
            <p class="built">You talk to Aaron and Luke. There's nobody in the middle, so the people on your discovery call are the ones who build your tool.</p>
          </div>
        </div>
      </div>

      <div class="cta">
        <p>{other.ctaLine}</p>
        <a class="pill" href={ctaHref}>Get It Sorted</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Swaps the panel when a tab is chosen, and opens on the service named in the address
  // (/services#custom-crms). Choosing a tab also puts its name in the address, so the page can be
  // shared or reloaded on the same service. The arrow keys, Home and End move between the tabs.
  document.querySelectorAll<HTMLElement>("[data-picker]").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const show = (id: string, opts: { focus?: boolean; animate?: boolean } = {}) => {
      if (!tabs.some((t) => t.dataset.tab === id)) return;
      tabs.forEach((t) => {
        const on = t.dataset.tab === id;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.tabIndex = on ? 0 : -1;
        if (on && opts.focus) t.focus();
      });
      panels.forEach((p) => {
        const on = p.dataset.panel === id;
        const wasShown = !p.hidden;
        p.hidden = !on;
        p.classList.remove("panel-in");
        // The new panel fades in. Reading offsetWidth restarts the fade if it was mid-way.
        if (on && !wasShown && opts.animate && !still) {
          void p.offsetWidth;
          p.classList.add("panel-in");
        }
      });
    };

    const choose = (id: string, focus = false) => {
      show(id, { focus, animate: true });
      history.replaceState(null, "", `#${id}`);
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => choose(t.dataset.tab!));
      t.addEventListener("keydown", (e) => {
        let next = -1;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        if (next < 0) return;
        e.preventDefault();
        choose(tabs[next].dataset.tab!, true);
      });
    });

    const fromHash = (animate = false) => {
      let id = "";
      try {
        id = decodeURIComponent(location.hash.replace("#", ""));
      } catch {
        return;
      }
      show(id, { animate });
    };
    fromHash();
    window.addEventListener("hashchange", () => fromHash(true));
  });
</script>

<style>
  /* This section brings its own 96px top padding (see the section spacing convention). */
  .picker { padding: 96px 24px 0; font-family: var(--font-body); }

  /* The off grey from the Case Study and About pages, solid so the tortoise marks stop at the card. */
  .card {
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    box-sizing: border-box;
    background: #f8f9f9;
    border: 1px solid var(--stone-200);
    border-radius: var(--radius-xl);
    padding: 48px 56px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* Lets the address bar jump to a service without the nav covering the tabs. */
  .anchor { position: absolute; top: 0; left: 0; width: 0; height: 0; scroll-margin-top: 120px; }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* The tabs. The chosen one fills with the brand teal, the rest stay quiet outlines. */
  .tabs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
  .tab {
    box-sizing: border-box;
    min-height: 128px;
    margin: 0;
    padding: 16px 18px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 18px;
    text-align: left;
    font-family: inherit;
    cursor: pointer;
    background: transparent;
    /* The icon takes this colour. */
    color: var(--deep-600);
    border: 1px solid rgba(10, 61, 54, 0.16);
    border-radius: var(--radius-lg);
    /* No grey flash when a tab is tapped on a phone. The fill is the feedback. */
    -webkit-tap-highlight-color: transparent;
    transition:
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .tab svg { display: block; flex-shrink: 0; }
  .tab-label {
    font-family: var(--font-display);
    font-size: 16.5px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.005em;
    color: var(--deep-700);
    text-wrap: balance;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .tab-other { border-style: dashed; border-color: rgba(10, 61, 54, 0.34); }
  /* Only where there is a mouse, so the white does not stick to a tab after a tap. */
  @media (hover: hover) {
    .tab:hover { background: #ffffff; border-color: rgba(10, 61, 54, 0.34); }
  }
  .tab[aria-selected="true"] {
    background: var(--deep-600);
    border-style: solid;
    border-color: var(--deep-600);
    color: var(--teal-200);
  }
  .tab[aria-selected="true"] .tab-label { color: #ffffff; }
  .tab:focus-visible { outline: 3px solid var(--deep-600); outline-offset: 3px; }
  /* Windows high contrast mode drops background colours, so the chosen tab gets a heavier edge. */
  @media (forced-colors: active) {
    .tab[aria-selected="true"] { border-width: 3px; }
  }

  .panel { margin: 0; display: flex; flex-direction: column; gap: 40px; }
  .panel[hidden] { display: none; }
  .panel-in { animation: svc-in var(--dur-med) var(--ease-out) both; }
  @keyframes svc-in {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel-in { animation: none; }
    .tab, .tab-label { transition: none; }
  }

  .split { display: grid; grid-template-columns: minmax(0, 1fr) 392px; gap: 56px; align-items: start; }
  .main { min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .intro { display: flex; flex-direction: column; gap: 16px; }
  h2 {
    margin: 0;
    font-size: 44px;
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--deep-700);
    text-wrap: balance;
  }
  .lead { margin: 0; max-width: 560px; font-size: 17px; line-height: 1.6; color: var(--text-soft); text-wrap: pretty; }

  .label {
    margin: 0;
    font-family: var(--font-display);
    font-size: 11.5px;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--deep-600);
  }

  .covers { display: flex; flex-direction: column; gap: 16px; }
  .points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 18px; }
  .points li { display: flex; gap: 14px; align-items: flex-start; }
  .dot {
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    margin-top: 1px;
    border-radius: var(--radius-pill);
    background: var(--teal-200);
    color: var(--deep-700);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .point { display: flex; flex-direction: column; gap: 2px; }
  .point-title { font-family: var(--font-display); font-size: 18px; font-weight: 700; line-height: 1.3; color: var(--deep-700); }
  .point-text { font-size: 16px; line-height: 1.5; color: var(--text-soft); text-wrap: pretty; }
  .jobs { gap: 12px; }
  .jobs .dot { margin-top: 0; }
  .job { font-size: 17px; line-height: 1.5; color: var(--deep-700); }

  /* The white box beside the list: who we built it for, and what they said. */
  .client {
    box-sizing: border-box;
    background: #ffffff;
    border: 1px solid var(--stone-200);
    border-radius: var(--radius-lg);
    padding: 26px 28px 14px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .client.call { padding-bottom: 28px; }
  .client-top { display: flex; align-items: center; gap: 14px; }
  .client-top img { display: block; flex-shrink: 0; width: auto; height: auto; max-width: 56px; max-height: 46px; }
  .client-id { display: flex; flex-direction: column; gap: 1px; }
  .client-name { font-family: var(--font-display); font-size: 17px; font-weight: 700; line-height: 1.25; color: var(--deep-700); }
  .client-trade { font-size: 13.5px; line-height: 1.4; color: var(--text-faint); }
  .rule { height: 1px; background: rgba(10, 61, 54, 0.14); }
  .client-block { display: flex; flex-direction: column; gap: 8px; }
  .built { margin: 0; font-size: 16px; line-height: 1.55; color: var(--text-soft); text-wrap: pretty; }
  .free {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--deep-700);
  }
  .quote { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--deep-700);
  }
  .quote figcaption { font-size: 14px; line-height: 1.4; color: var(--text-faint); }
  .see {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    color: var(--deep-700);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .see:hover { color: var(--deep-600); }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid rgba(10, 61, 54, 0.14);
    padding-top: 32px;
  }
  .cta p { margin: 0; font-family: var(--font-display); font-size: 26px; font-weight: 700; line-height: 1.2; color: var(--deep-700); text-wrap: balance; }
  .pill {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    box-sizing: border-box;
    padding: 0 30px;
    border-radius: var(--radius-pill);
    background: var(--amber-500);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
