---
// Home video section, locked 18 Sep 2026, reordered 19 Sep 2026 (Video board on the
// Sortoise Home canvas).
// The section sits on the same half see-through panel as the FAQ, so the tortoise
// marks still read faintly behind it. The Watch eyebrow sits above the video and the heading sits
// under it, so the section opens on the frame. The video frame is its own solid Deep 950
// surface, 960px wide inside the 1120px cap, pink play button, three chapter markers
// under the heading.
// On phones the chapters stack open, each with the same rule above it as the desktop
// columns. There is no fold and no "What's in the video" row any more.
// 12 Oct 2026: the real video went in (public/video/sortoise-demo.mp4, 1:34, the invoicing tool
// demo with made-up data). The heading and the three chapters now describe that video, with its
// real timings.
//
// src: the video file on this site (public/video). Played in the browser's own player.
// embedUrl: a YouTube or Vimeo "embed" address, only used if there is no src.
// poster / posterWebp: the image shown in the frame before play (jpg fallback plus webp).
// Now a still from the video itself ("Log it from the van.", 0:09).
// The play button and the swap to the video live in src/scripts/video-frame.ts.
interface Props {
  src?: string;
  embedUrl?: string;
  poster?: string;
  posterWebp?: string;
}

const { src = "", embedUrl = "", poster = "", posterWebp = "" } = Astro.props;

// If the video is re-cut, change these times to match.
const chapters = [
  { time: "0:00", title: "Log it from the van", text: "The job's done, so it goes in on your phone before you drive off." },
  { time: "0:22", title: "Waiting at your desk", text: "The invoice is ready when you get back, with the VAT worked out and the health and safety sheet to print with it." },
  { time: "0:50", title: "Your whole business, on one screen", text: "Every invoice in one place, a read-only view for your bookkeeper, and room to add what you need." },
];
---

<section id="video" class="video">
  <div class="inner">
    <div class="eyebrow video-eyebrow">Watch</div>

    <div class="frame" data-video-frame data-src={src} data-embed={embedUrl} data-title="Sortoise invoicing tool, from the van to the desk">
      {poster && (
        <picture class="poster">
          {posterWebp && <source srcset={posterWebp} type="image/webp" />}
          <img src={poster} alt="" width="1600" height="900" loading="lazy" decoding="async" />
        </picture>
      )}
      <button type="button" class="play" data-play aria-label="Play the video">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5z" fill="#ffffff"></path></svg>
      </button>
    </div>

    <div class="heading">
      <h2>Here's one of our tools <span class="nowrap">doing the paperwork</span></h2>
    </div>

    <div id="video-chapters" class="chapters">
      {chapters.map((c) => (
        <div class="chapter">
          <div class="time">{c.time}</div>
          <div class="chapter-body">
            <div class="chapter-title">{c.title}</div>
            <p>{c.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import "../scripts/video-frame.ts";
</script>

<style>
  /* Sections sit 96px apart. This section adds nothing above (the hero's bottom padding
     covers that) and nothing below; the next section brings its own 96px top. */
  .video { padding: 0 24px; font-family: var(--font-body); }
  /* The same see-through panel as FAQ.astro: half white, so the tortoise marks on the
     ground still show through it, with a hairline of the deep green at 13%. */
  .inner {
    box-sizing: border-box;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 48px 56px;
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid rgba(10, 61, 54, 0.13);
    display: flex; flex-direction: column; align-items: center; gap: 40px;
  }
  .heading { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  .video-eyebrow { color: var(--teal-600); }
  h2 {
    margin: 0;
    font-size: 44px;
    max-width: 880px;
    color: var(--ground-text, var(--deep-700));
  }
  .nowrap { white-space: nowrap; }

  .frame {
    position: relative;
    width: 100%; max-width: 960px;
    aspect-ratio: 16 / 9;
    background: var(--deep-950);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .poster { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .frame :global(video) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: contain; background: var(--deep-950);
  }
  .play {
    position: relative;
    width: 96px; height: 96px; padding: 0; border: 0;
    border-radius: var(--radius-pill);
    background: var(--pink-500);
    box-shadow: var(--shadow-raised);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .play:hover { background: var(--pink-400); }

  .chapters {
    width: 100%; max-width: 960px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .chapter {
    display: flex; flex-direction: column; gap: 6px;
    padding-top: 16px;
    border-top: 2px solid var(--ground-rule, var(--paper-500));
  }
  .time {
    font-family: var(--font-display);
    font-size: var(--text-xs); font-weight: 600;
    letter-spacing: var(--tracking-caps); text-transform: uppercase;
    color: var(--teal-600);
  }
  .chapter-body { display: flex; flex-direction: column; gap: 6px; }
  .chapter-title {
    font-family: var(--font-display);
    font-size: 19px; font-weight: 700;
    color: var(--ground-text, var(--deep-700));
  }
  .chapter p {
    margin: 0;
    font-size: 15px; line-height: var(--leading-body);
    color: var(--ground-text-soft, var(--stone-700));
  }

  @media (max-width: 820px) {
    .video { padding: 0 16px; }
    .inner { padding: 32px 20px; border-radius: var(--radius-lg); gap: 24px; }
    .heading { gap: 10px; }
    h2 { font-size: 32px; }
    .frame { border-radius: var(--radius-lg); }
    .play { width: 64px; height: 64px; }
    .play svg { width: 26px; height: 26px; }

    /* The chapters stack open, keeping the same rule above each one that the desktop
       columns have. That rule is what the old toggle bar's borders used to provide. */
    .chapters { display: flex; flex-direction: column; gap: 16px; }
    .chapter { flex-direction: row; gap: 14px; align-items: flex-start; }
    .time { flex-shrink: 0; width: 44px; padding-top: 3px; letter-spacing: 0.1em; }
    .chapter-body { gap: 2px; }
    .chapter-title { font-size: 17px; }
    .chapter p { font-size: 14px; line-height: 1.5; }
  }
</style>
