---
// Home video section, locked 18 Sep 2026 (Video board on the Sortoise Home canvas).
// Bare on the page ground. The video frame is its own solid Deep 950 surface, 960px wide
// inside the 1120px cap, pink play button, three chapter markers under it.
// On phones the chapters fold into a "What's in the video" row that opens on tap.
// Copy matches the board 1:1. Do not change without Aaron.
//
// embedUrl: the video's embed address (YouTube or Vimeo "embed" link). Empty for now,
// so the play button is there but does nothing until the address is added.
// poster / posterWebp: the image shown in the frame before play (jpg fallback plus webp).
// Currently the placeholder still of Aaron until the real video thumbnail exists.
interface Props {
  embedUrl?: string;
  poster?: string;
  posterWebp?: string;
}

const { embedUrl = "", poster = "", posterWebp = "" } = Astro.props;

const chapters = [
  { time: "0:00", title: "The job that eats your week", text: "Spreadsheets, paper, WhatsApp and the owner's memory." },
  { time: "0:40", title: "One tool, built to fit", text: "Logged once, done properly, nothing depends on you remembering." },
  { time: "1:20", title: "Then we keep it running", text: "Hosting, fixes, changes, and the next plate when you need it." },
];
---

<section id="video" class="video">
  <div class="inner">
    <div class="heading">
      <div class="eyebrow video-eyebrow">Watch</div>
      <h2>How we diagnose a business, <span class="nowrap">then sort it</span></h2>
    </div>

    <div class="frame" data-embed={embedUrl}>
      {poster && (
        <picture class="poster">
          {posterWebp && <source srcset={posterWebp} type="image/webp" />}
          <img src={poster} alt="" width="1600" height="900" loading="lazy" decoding="async" />
        </picture>
      )}
      <button type="button" class="play" aria-label="Play video">
        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5.5v13l11-6.5-11-6.5z" fill="#ffffff"></path></svg>
      </button>
    </div>

    <button type="button" class="chapters-toggle" aria-expanded="false" aria-controls="video-chapters">
      <span>What's in the video</span>
      <span class="toggle-right">
        <span>{chapters.length} parts</span>
        <svg class="chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="#188f80" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </span>
    </button>

    <div id="video-chapters" class="chapters">
      {chapters.map((c) => (
        <div class="chapter">
          <div class="time">{c.time}</div>
          <div class="chapter-body">
            <div class="chapter-title">{c.title}</div>
            <p>{c.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Play: when the frame has an embed address, swap the frame contents for the video player.
  // With no address yet, the button does nothing.
  document.querySelectorAll<HTMLElement>(".video .frame").forEach((frame) => {
    const play = frame.querySelector<HTMLButtonElement>(".play");
    play?.addEventListener("click", () => {
      const src = frame.dataset.embed;
      if (!src) return;
      const iframe = document.createElement("iframe");
      iframe.src = src + (src.includes("?") ? "&" : "?") + "autoplay=1";
      iframe.title = "Sortoise video";
      iframe.allow = "autoplay; fullscreen; picture-in-picture";
      iframe.setAttribute("allowfullscreen", "");
      frame.replaceChildren(iframe);
    });
  });

  // Phone: the chapters row opens and closes the list.
  document.querySelectorAll<HTMLButtonElement>(".chapters-toggle").forEach((btn) => {
    const list = document.getElementById(btn.getAttribute("aria-controls") || "");
    btn.addEventListener("click", () => {
      const open = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", open ? "false" : "true");
      list?.classList.toggle("open", !open);
    });
  });
</script>

<style>
  /* Sections sit 96px apart. This section adds nothing above (the hero's bottom padding
     covers that) and nothing below; the next section brings its own 96px top. */
  .video { padding: 0 24px; font-family: var(--font-body); }
  .inner {
    max-width: var(--container-max);
    margin: 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 40px;
  }
  .heading { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; }
  .video-eyebrow { color: var(--teal-600); }
  h2 {
    margin: 0;
    font-size: 44px;
    max-width: 880px;
    color: var(--ground-text, var(--deep-700));
  }
  .nowrap { white-space: nowrap; }

  .frame {
    position: relative;
    width: 100%; max-width: 960px;
    aspect-ratio: 16 / 9;
    background: var(--deep-950);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .poster { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .play {
    position: relative;
    width: 96px; height: 96px; padding: 0; border: 0;
    border-radius: var(--radius-pill);
    background: var(--pink-500);
    box-shadow: var(--shadow-raised);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .play:hover { background: var(--pink-400); }

  .chapters-toggle { display: none; }

  .chapters {
    width: 100%; max-width: 960px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .chapter {
    display: flex; flex-direction: column; gap: 6px;
    padding-top: 16px;
    border-top: 2px solid var(--ground-rule, var(--paper-500));
  }
  .time {
    font-family: var(--font-display);
    font-size: var(--text-xs); font-weight: 600;
    letter-spacing: var(--tracking-caps); text-transform: uppercase;
    color: var(--teal-600);
  }
  .chapter-body { display: flex; flex-direction: column; gap: 6px; }
  .chapter-title {
    font-family: var(--font-display);
    font-size: 19px; font-weight: 700;
    color: var(--ground-text, var(--deep-700));
  }
  .chapter p {
    margin: 0;
    font-size: 15px; line-height: var(--leading-body);
    color: var(--ground-text-soft, var(--stone-700));
  }

  @media (max-width: 820px) {
    .video { padding: 0 16px; }
    .inner { gap: 24px; }
    .heading { gap: 10px; }
    h2 { font-size: 32px; }
    .frame { border-radius: var(--radius-lg); }
    .play { width: 64px; height: 64px; }
    .play svg { width: 26px; height: 26px; }

    .chapters-toggle {
      display: flex; align-items: center; justify-content: space-between;
      width: 100%; min-height: 48px; padding: 0 4px;
      border: 0;
      border-top: 2px solid var(--ground-rule, var(--paper-500));
      border-bottom: 2px solid var(--ground-rule, var(--paper-500));
      background: transparent; cursor: pointer;
      font-family: var(--font-display); font-size: 15px; font-weight: 700;
      color: var(--ground-text, var(--deep-700));
      text-align: left;
    }
    .toggle-right {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 12px; font-weight: 600;
      letter-spacing: var(--tracking-caps); text-transform: uppercase;
      color: var(--teal-600);
    }
    .chevron { transition: transform var(--dur-med) var(--ease-out); }
    .chapters-toggle[aria-expanded="true"] .chevron { transform: rotate(180deg); }

    .chapters { display: none; margin-top: -8px; gap: 16px; }
    .chapters.open { display: flex; flex-direction: column; }
    .chapter { flex-direction: row; gap: 14px; align-items: flex-start; padding-top: 0; border-top: 0; }
    .time { flex-shrink: 0; width: 44px; padding-top: 3px; letter-spacing: 0.1em; }
    .chapter-body { gap: 2px; }
    .chapter-title { font-size: 17px; }
    .chapter p { font-size: 14px; line-height: 1.5; }
  }
</style>
