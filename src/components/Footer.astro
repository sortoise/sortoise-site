---
// Site footer, locked 19 Sep 2026 (Footer board on the Sortoise Home canvas, variation F1a).
// A flat Amber 500 band that runs the full width of the screen. It sits OUTSIDE the page ground,
// so the tortoise pattern never shows behind it.
// Left: the logo, the line "Do More with Less." and a cream "Get It Sorted" button.
// Right: two short lists, Pages and Contact.
// Bottom: a thin rule, the copyright line and the two legal links.
// Two big pale tortoise marks sit behind the text as decoration and are cut off by the footer edge.
//
// Every fact here came from Aaron. Sortoise is not a registered company yet, so there is no
// company number or registered address. Add them to the bottom line when that changes.
import Mark from "./Mark.astro";

// The page links. About, Services and Case Study are holding pages until the real ones are built.
const pages = [
  { label: "Home", href: "/" },
  { label: "Services", href: "/services" },
  { label: "Case Study", href: "/case-study" },
  { label: "About", href: "/about" },
];

// The legal pages do not exist yet either. These are the addresses they will use.
const legal = [
  { label: "Privacy policy", href: "/privacy-policy" },
  { label: "Terms and conditions", href: "/terms-and-conditions" },
];

const email = "sortoisesolutions@gmail.com";

// PLACEHOLDER: Aaron to send the LinkedIn page address. Swap the "#" for it.
const linkedinHref = "#";

// Where "Get It Sorted" goes. Point this at the Calendly booking once that is set up.
const ctaHref = "#";

const year = 2026;
---

<footer class="site-footer">
  <svg class="deco deco-a" viewBox="0 0 160 160" aria-hidden="true"><use href="#footer-mark" /></svg>
  <svg class="deco deco-b" viewBox="0 0 160 160" aria-hidden="true"><use href="#footer-mark" /></svg>

  <!-- The pale tortoise shape, drawn once here and used twice above. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <symbol id="footer-mark" viewBox="0 0 160 160">
      <g fill="var(--amber-400)">
        <ellipse rx="19" ry="11" transform="translate(34,50) rotate(-40)"></ellipse>
        <ellipse rx="19" ry="11" transform="translate(126,50) rotate(40)"></ellipse>
        <ellipse rx="19" ry="11" transform="translate(34,110) rotate(40)"></ellipse>
        <ellipse rx="19" ry="11" transform="translate(126,110) rotate(-40)"></ellipse>
        <path d="M80 0c9 0 15 7 15 16s-6 18-15 18-15-9-15-18S71 0 80 0z"></path>
        <path d="M80 126c6 0 9 9 9 16s-4 12-9 12-9-5-9-12 3-16 9-16z"></path>
        <ellipse cx="80" cy="80" rx="55" ry="59"></ellipse>
      </g>
      <ellipse cx="80" cy="80" rx="42" ry="46" fill="var(--amber-500)"></ellipse>
      <g fill="var(--amber-400)">
        <path d="M80 38c9 0 14 6 14 14s-5 12-14 12-14-5-14-12 5-14 14-14z"></path>
        <path d="M80 96c9 0 14 6 14 13s-5 13-14 13-14-6-14-13 5-13 14-13z"></path>
        <ellipse cx="80" cy="80" rx="15" ry="14"></ellipse>
      </g>
    </symbol>
  </svg>

  <div class="inner">
    <div class="top">
      <div class="brand-block">
        <a href="/" class="brand" aria-label="Sortoise home">
          <span class="mark-desktop"><Mark size={64} /></span>
          <span class="mark-phone"><Mark size={52} /></span>
          <span class="brand-name">Sortoise</span>
        </a>
        <p class="line">Do More with Less.</p>
        <a href={ctaHref} class="pill">Get It Sorted</a>
      </div>

      <div class="cols">
        <nav class="col" aria-label="Footer pages">
          <h2 class="label">Pages</h2>
          <ul>
            {pages.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
          </ul>
        </nav>
        <div class="col">
          <h2 class="label">Contact</h2>
          <ul>
            <li><a href={`mailto:${email}`} class="underlined email">{email}</a></li>
            <li>
              <a href={linkedinHref} class="social">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3zM10 9.75h3.8v1.6c.6-1.1 1.9-1.9 3.7-1.9 3.2 0 4.5 2 4.5 5.4v5.9h-4v-5.3c0-1.6-.6-2.6-1.9-2.6-1.4 0-2.1 1-2.1 2.6v5.3h-4z"/></svg>
                LinkedIn
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="bottom">
      <span class="copy">© {year} Sortoise</span>
      <div class="legal">
        {legal.map((l) => <a href={l.href} class="underlined">{l.label}</a>)}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--amber-500);
    color: var(--deep-950);
    font-family: var(--font-body);
    padding: 64px 60px 28px;
  }
  .inner { position: relative; max-width: 1120px; margin: 0 auto; }

  /* The two pale tortoise marks behind the text. */
  .deco { position: absolute; opacity: 0.55; pointer-events: none; }
  .deco-a { width: 340px; height: 340px; top: -120px; left: calc(50% - 160px); transform: rotate(152deg); }
  .deco-b { width: 220px; height: 220px; right: -50px; bottom: -70px; transform: rotate(-38deg); }

  .top { display: flex; justify-content: space-between; gap: 64px; padding-bottom: 48px; }
  .brand-block { display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  .brand { display: inline-flex; align-items: center; gap: 14px; text-decoration: none; }
  .mark-phone { display: none; }
  .brand-name {
    font-family: var(--font-display);
    font-size: 38px; font-weight: 700; letter-spacing: -0.02em;
    color: var(--deep-950);
  }
  .line {
    margin: 0;
    font-family: var(--font-display);
    font-size: 24px; font-weight: 500; letter-spacing: -0.01em;
    color: var(--deep-950);
  }
  .pill {
    margin-top: 6px;
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 52px; padding: 0 30px;
    border-radius: var(--radius-pill);
    background: var(--paper-200); color: var(--deep-950);
    font-family: var(--font-display); font-size: 17px; font-weight: 600;
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .pill:hover { background: var(--paper-100); }

  .cols { display: flex; gap: 96px; padding-top: 10px; }
  .col { display: flex; flex-direction: column; gap: 12px; }
  .label {
    margin: 0;
    font-family: var(--font-display);
    font-size: 11.5px; font-weight: 600; line-height: 1.55;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--deep-950); opacity: 0.72;
  }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; align-items: flex-start; }
  .col a {
    display: inline-flex; align-items: center; gap: 8px;
    min-height: 28px;
    font-size: 16px; font-weight: 400;
    color: var(--deep-950); text-decoration: none;
  }
  .col a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .underlined, .col a.underlined {
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px;
  }
  .social { margin-top: 4px; }

  .bottom {
    border-top: 1px solid rgba(6, 31, 28, 0.22);
    padding-top: 22px;
    display: flex; align-items: center; justify-content: space-between; gap: 28px;
    font-size: 14px; color: var(--deep-950);
  }
  .legal { display: flex; gap: 24px; }
  .legal a { display: inline-flex; align-items: center; min-height: 28px; font-size: 14px; color: var(--deep-950); }
  .site-footer a:hover { color: var(--deep-700); }
  .site-footer a:focus-visible { outline: 3px solid var(--deep-950); outline-offset: 3px; border-radius: 4px; }
  .pill:focus-visible { border-radius: var(--radius-pill); }

  /* Phones and small tablets: everything stacks, the two lists stay side by side. */
  @media (max-width: 820px) {
    .site-footer { padding: 48px 16px 24px; }
    .deco-a { width: 220px; height: 220px; top: -80px; left: auto; right: -70px; }
    .deco-b { width: 150px; height: 150px; right: -40px; bottom: -52px; }
    .top { flex-direction: column; gap: 40px; padding-bottom: 36px; }
    .brand-block { gap: 16px; }
    .brand { gap: 12px; }
    .mark-desktop { display: none; }
    .mark-phone { display: block; }
    .brand-name { font-size: 32px; }
    .line { font-size: 21px; }
    .pill { margin-top: 4px; }
    .cols { gap: 40px; padding-top: 0; }
    .col { gap: 10px; }
    ul { gap: 4px; }
    .col a { min-height: 32px; }
    .email { font-size: 15px; }
    .bottom { flex-direction: column-reverse; align-items: flex-start; gap: 6px; padding-top: 18px; }
    .legal { gap: 20px; }
    .legal a { min-height: 32px; }
  }
</style>
