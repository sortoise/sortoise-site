---
// Site nav: floating white bar, logo left, links centred, one pink pill.
// Under 820px the links hide and a burger opens a panel. Matches the locked Hero board.
import Mark from "./Mark.astro";

interface NavItem { label: string; href: string; }
interface Props {
  items?: NavItem[];
  cta?: { label: string; href: string };
}

const {
  items = [
    { label: "Services", href: "#services" },
    { label: "Case study", href: "#case-study" },
    { label: "Who we are", href: "#who-we-are" },
    { label: "FAQ", href: "#faq" },
  ],
  cta = { label: "Sort", href: "#" },
} = Astro.props;
---

<nav class="site-nav">
  <div class="row">
    <a href="/" class="brand">
      <Mark size={44} />
      <span class="brand-name">Sortoise</span>
    </a>
    <div class="links">
      {items.map((item) => <a href={item.href} class="link">{item.label}</a>)}
    </div>
    <div class="cta-wrap">
      <a href={cta.href} class="pill">{cta.label}</a>
    </div>
    <button class="burger" type="button" aria-label="Menu" aria-expanded="false" aria-controls="nav-panel">
      <svg class="icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M3 7h18M3 12h18M3 17h18"/></svg>
      <svg class="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M5 5l14 14M19 5L5 19"/></svg>
    </button>
  </div>
  <div class="panel" id="nav-panel" hidden>
    {items.map((item) => <a href={item.href} class="panel-link">{item.label}</a>)}
    <div class="panel-cta"><a href={cta.href} class="pill">{cta.label}</a></div>
  </div>
</nav>

<style>
  .site-nav {
    font-family: var(--font-body);
    background: var(--surface-card);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    border: 1px solid var(--border-soft);
    padding: 12px 14px 12px 20px;
  }
  .row { display: flex; align-items: center; gap: 20px; }
  .brand { display: inline-flex; align-items: center; gap: 11px; text-decoration: none; }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    letter-spacing: var(--tracking-display);
    color: var(--deep-700);
  }
  .links { display: flex; align-items: center; gap: 2px; flex: 1; justify-content: center; }
  .link {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 9px 14px;
    border-radius: var(--radius-pill);
    font-size: 15px; font-weight: 500; letter-spacing: -0.005em;
    text-decoration: none;
    color: var(--stone-700);
    background: transparent;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
  }
  .link:hover { color: var(--deep-700); background: var(--paper-200); }
  .cta-wrap { display: flex; align-items: center; gap: 10px; }
  .pill {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    background: var(--pink-500);
    color: var(--deep-950);
    font-family: var(--font-display);
    font-size: 15px; font-weight: 700; letter-spacing: -0.01em;
    text-decoration: none; white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .pill:hover { background: var(--pink-400); color: var(--deep-950); }
  .burger {
    display: none; align-items: center; justify-content: center;
    width: 42px; height: 42px; margin-left: auto;
    border-radius: var(--radius-pill);
    background: transparent;
    border: 1px solid var(--border-soft);
    color: var(--deep-700);
    cursor: pointer;
  }
  .burger .icon-close { display: none; }
  .burger[aria-expanded="true"] .icon-open { display: none; }
  .burger[aria-expanded="true"] .icon-close { display: block; }
  .panel {
    display: grid; gap: 2px;
    padding-top: 14px; margin-top: 12px;
    border-top: 1px solid var(--border-soft);
  }
  .panel[hidden] { display: none; }
  .panel-link {
    padding: 11px 12px;
    border-radius: var(--radius-md);
    font-size: 16px; font-weight: 600;
    color: var(--deep-700);
    text-decoration: none;
  }
  .panel-cta { padding-top: 8px; }
  @media (max-width: 820px) {
    .links, .cta-wrap { display: none; }
    .burger { display: inline-flex; }
  }
</style>

<script>
  // Opens and closes the phone menu.
  const burger = document.querySelector<HTMLButtonElement>(".site-nav .burger");
  const panel = document.querySelector<HTMLElement>(".site-nav .panel");
  if (burger && panel) {
    burger.addEventListener("click", () => {
      const open = burger.getAttribute("aria-expanded") === "true";
      burger.setAttribute("aria-expanded", open ? "false" : "true");
      panel.hidden = open;
    });
    panel.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        burger.setAttribute("aria-expanded", "false");
        panel.hidden = true;
      })
    );
  }
</script>
