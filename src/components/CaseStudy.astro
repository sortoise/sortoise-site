---
// Home case studies section (condensed), locked 19 Sep 2026 (CaseStudy board on the Sortoise Home canvas).
// One Deep Teal card on the page ground, the emphasis block on Home. Inside it:
//   1. "Case studies" heading with two client buttons. Clicking a client swaps the white story panel.
//   2. The story panel: headline, the problem, four "what we built" cards, and a small link to that
//      client's story on the Case Study page.
//   3. Under a faint line, the "Based in South Wales" block: billboard photo, text, amber button.
// Copy matches the board 1:1. Do not change without Aaron.
// This is the condensed version of the Case Study page; the page expands the same stories.

const studies = [
  {
    id: "d-w-jenkins",
    name: "D W Jenkins",
    trade: "Building contractor",
    logo: "/logos/clients/d-w-jenkins.png",
    headline: "How we cut 8 to 12 hours of weekly admin.",
    problem:
      "Paid per item, so every address meant counting quantities, writing a health and safety document and gathering photo evidence by hand, all before the invoice.",
    built: [
      { icon: "phone", title: "Site app", text: "Items and quantities logged on the job" },
      { icon: "clipboard", title: "H&S builder", text: "A few questions and the document is done" },
      { icon: "click", title: "One-click invoice pack", text: "Everything he needs to get paid" },
      { icon: "trail", title: "Audit trail", text: "Every job and his earnings in one place" },
    ],
  },
  {
    id: "cavity-wall-extraction-uk",
    name: "Cavity Wall Extraction UK",
    trade: "Surveys and extraction",
    // A light copy of the client's logo (the dark green letters recoloured cream) so it reads on the green card.
    logo: "/logos/clients/cavity-wall-extraction-uk-light.png",
    headline: "How we built Steve a CRM that runs itself.",
    problem:
      "A paid-for CRM that felt like a dolled-up spreadsheet. Leads, proposals and chasers were all still moved by hand, and missed calls never made it in.",
    built: [
      { icon: "inbox", title: "Lead inbox", text: "Form leads and missed calls in one place" },
      { icon: "message", title: "Instant text and reminders", text: "On arrival, and 24 hours before the visit" },
      { icon: "phone", title: "Survey app", text: "Recorded on site, the lead moves itself" },
      { icon: "sign", title: "Proposal and e-sign", text: "Chased by text and email, call at day 5" },
    ],
  },
];

// The Case Study page does not exist yet. Each link carries the client's id so the page can open on that story.
const caseStudyPage = "/case-study";
// Same destination as the hero button. Point both at the Calendly booking when that is set up.
const ctaHref = "#";
---

<section id="case-study" class="case-study">
  <div class="card">
    <div class="top">
      <div class="rail">
        <h2>Case studies</h2>
        <div class="clients" role="tablist" aria-label="Choose a case study">
          {studies.map((s, i) => (
            <button
              type="button"
              class="client"
              role="tab"
              id={`cs-tab-${s.id}`}
              aria-controls={`cs-panel-${s.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-cs-tab={s.id}
            >
              <span class="logo"><img src={s.logo} alt="" loading="lazy" decoding="async" /></span>
              <span class="who">
                <span class="name">{s.name}</span>
                <span class="trade">{s.trade}</span>
              </span>
              <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
            </button>
          ))}
        </div>
      </div>

      {studies.map((s, i) => (
        <div class="panel" role="tabpanel" id={`cs-panel-${s.id}`} aria-labelledby={`cs-tab-${s.id}`} data-cs-panel={s.id} hidden={i !== 0}>
          <h3 class="headline">{s.headline}</h3>
          <div class="block">
            <div class="label label-problem">The problem</div>
            <p class="problem">{s.problem}</p>
          </div>
          <div class="block">
            <div class="label">What we built</div>
            <ul class="built">
              {s.built.map((b) => (
                <li class="built-card">
                  <span class="icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      {b.icon === "phone" && <><rect x="7" y="2.5" width="10" height="19" rx="2.2"/><path d="M11 18.5h2"/></>}
                      {b.icon === "clipboard" && <><rect x="6" y="4" width="12" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M9 10h6"/><path d="M9 14h6"/></>}
                      {b.icon === "click" && <><path d="M9 9l10 4-4.5 1.5L13 19z"/><path d="M5 5l2 2"/><path d="M12 3v2.5"/><path d="M3 12h2.5"/></>}
                      {b.icon === "trail" && <><path d="M8 6h12"/><path d="M8 12h12"/><path d="M8 18h12"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/></>}
                      {b.icon === "inbox" && <><path d="M4 13l2.5-8h11L20 13v6H4z"/><path d="M4 13h5l1 2h4l1-2h5"/></>}
                      {b.icon === "message" && <><path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8"/><path d="M8 12h5"/></>}
                      {b.icon === "sign" && <><path d="M4 20h16"/><path d="M6 16l9-9 3 3-9 9H6z"/></>}
                    </svg>
                  </span>
                  <span class="built-text">
                    <span class="built-title">{b.title}</span>
                    <span class="built-line">{b.text}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
          <div class="more"><a href={`${caseStudyPage}#${s.id}`}>Read the full case study</a></div>
        </div>
      ))}
    </div>

    <div class="rule"></div>

    <div class="local">
      <picture class="photo">
        <source srcset="/images/billboard-parc-tawe.webp" type="image/webp" />
        <img src="/images/billboard-parc-tawe.jpg" width="1600" height="1000" loading="lazy" decoding="async" alt="The Sortoise advert on the big screen at Parc Tawe shopping centre, Swansea" />
      </picture>
      <div class="local-text">
        <h3 class="local-head">Based in South Wales, serving UK businesses.</h3>
        <p>You might have seen us at Parc Tawe in Swansea. What you might not know is that we work with businesses right across the UK. Our software, mobile and web apps are putting them ahead of the game. Want to see what we could do for you?</p>
        <a href={ctaHref} class="cta">Get It Sorted</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Swaps the story panel when a client button is clicked. Left and right arrow keys move between clients.
  document.querySelectorAll<HTMLElement>("#case-study").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-cs-tab]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-cs-panel]"));
    const show = (id: string, focus = false) => {
      tabs.forEach((t) => {
        const on = t.dataset.csTab === id;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.tabIndex = on ? 0 : -1;
        if (on && focus) t.focus();
      });
      panels.forEach((p) => { p.hidden = p.dataset.csPanel !== id; });
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => show(t.dataset.csTab!));
      t.addEventListener("keydown", (e) => {
        if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp"].includes(e.key)) return;
        e.preventDefault();
        const step = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : -1;
        show(tabs[(i + step + tabs.length) % tabs.length].dataset.csTab!, true);
      });
    });
  });
</script>

<style>
  /* This section brings its own 96px top padding (see the section spacing convention). */
  .case-study { padding: 96px 24px 0; font-family: var(--font-body); }
  .card {
    max-width: var(--container-max);
    margin: 0 auto;
    box-sizing: border-box;
    background: var(--deep-700);
    border-radius: var(--radius-xl);
    padding: 56px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .top { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 36px; align-items: start; }
  .rail { display: flex; flex-direction: column; gap: 24px; }
  h2 { margin: 0; font-size: 34px; color: var(--paper-200); }

  .clients { display: flex; flex-direction: column; gap: 10px; }
  .client {
    box-sizing: border-box;
    width: 100%;
    min-height: 76px;
    padding: 10px 12px 10px 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;
    font-family: inherit;
    cursor: pointer;
    background: transparent;
    border: 1px solid rgba(250, 245, 224, 0.18);
    border-radius: var(--radius-lg);
    transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .client:hover { border-color: rgba(250, 245, 224, 0.4); }
  .client[aria-selected="true"] { background: rgba(250, 245, 224, 0.14); border-color: rgba(250, 245, 224, 0.55); }
  .client:focus-visible { outline: 3px solid var(--teal-400); outline-offset: 3px; }
  .logo { flex-shrink: 0; width: 60px; height: 54px; display: flex; align-items: center; justify-content: center; }
  .logo img { max-width: 60px; max-height: 50px; display: block; }
  .who { display: flex; flex-direction: column; gap: 2px; }
  .name { font-family: var(--font-display); font-size: 15px; font-weight: 700; line-height: 1.15; color: var(--paper-200); }
  .trade { font-size: 13px; line-height: 1.3; color: var(--teal-200); }
  .arrow { margin-left: auto; flex-shrink: 0; color: var(--paper-200); opacity: 0; }
  .client[aria-selected="true"] .arrow { opacity: 1; }

  .panel {
    box-sizing: border-box;
    background: var(--paper-200);
    border-radius: var(--radius-lg);
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .panel[hidden] { display: none; }
  .headline { margin: 0; font-size: 30px; line-height: 1.12; letter-spacing: -0.02em; color: var(--deep-700); }
  .block { display: flex; flex-direction: column; gap: 8px; }
  .label {
    font-family: var(--font-display);
    font-size: var(--text-micro);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--deep-600);
  }
  .label-problem { color: var(--pink-600); }
  .problem { margin: 0; font-size: 16px; line-height: var(--leading-body); color: var(--text-soft); }
  .built { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .built-card {
    box-sizing: border-box;
    background: var(--paper-100);
    border: 1px solid var(--paper-400);
    border-radius: var(--radius-md);
    padding: 16px 18px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    background: var(--teal-100);
    color: var(--deep-700);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .built-text { display: flex; flex-direction: column; gap: 3px; }
  .built-title { font-family: var(--font-display); font-size: 16px; font-weight: 700; color: var(--deep-700); }
  .built-line { font-size: 14px; line-height: 1.4; color: var(--text-soft); }
  .more { display: flex; justify-content: flex-end; }
  .more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14.5px;
    font-weight: 400;
    color: var(--deep-600);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .more a:hover { color: var(--deep-500); }

  .rule { height: 1px; background: rgba(250, 245, 224, 0.32); }

  .local { display: grid; grid-template-columns: 480px minmax(0, 1fr); gap: 48px; align-items: center; }
  .photo { display: block; }
  .photo img { display: block; width: 100%; height: auto; aspect-ratio: 8 / 5; object-fit: cover; border-radius: var(--radius-lg); }
  .local-text { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .local-head { margin: 0; font-size: 34px; line-height: 1.08; color: var(--paper-200); }
  .local-text p { margin: 0; font-size: 17px; line-height: 1.6; color: var(--teal-100); }
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    box-sizing: border-box;
    margin-top: 6px;
    padding: 0 30px;
    border-radius: var(--radius-pill);
    background: var(--amber-500);
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--deep-950);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .cta:hover { background: var(--amber-400); color: var(--deep-950); }
  .cta:focus-visible { outline: 3px solid var(--teal-300); outline-offset: 3px; }

  @media (max-width: 820px) {
    .case-study { padding: 96px 16px 0; }
    .card { padding: 32px 16px 24px; gap: 28px; }
    .top { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .rail { gap: 20px; }
    h2 { font-size: 30px; padding: 0 4px; }
    .panel { padding: 26px 20px 22px; gap: 18px; }
    .headline { font-size: 25px; line-height: 1.14; }
    .built { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .more { justify-content: flex-start; }
    .local { grid-template-columns: minmax(0, 1fr); gap: 18px; padding: 0 4px; }
    .local-text { display: contents; }
    .local-head { order: -1; font-size: 27px; line-height: 1.1; }
    .local-text p { font-size: 16px; }
    .cta { margin-top: 0; justify-self: start; }
  }
</style>
