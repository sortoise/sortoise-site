---
// Home page. Section order per site-structure: nav, hero, video, services,
// case study, feedback, who we are, FAQ, footer. Nav, hero, video, services, case study and feedback are built so far.
import PageShell from "../layouts/PageShell.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import Video from "../components/Video.astro";
import Services from "../components/Services.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Feedback from "../components/Feedback.astro";
---

<PageShell title="Sortoise | Custom software for small businesses">
  <div class="page-ground">
    <div class="nav-wrap">
      <SiteNav />
    </div>
    <Hero />
    <Video />
    <Services />
    <CaseStudy />
    <Feedback />
    <!-- Next sections go here, inside the page-ground wrapper: who we are, FAQ. -->
  </div>
  <!-- Footer goes here, outside the page-ground wrapper (the footer stays flat). -->
</PageShell>

<style>
  .page-ground { width: 100%; min-height: 100vh; }
  .nav-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 20px 60px 0;
  }
  @media (max-width: 820px) {
    .nav-wrap { padding: 12px 16px 0; }
  }
</style>
