---
// Home page. Section order per site-structure: nav, hero, video, services,
// case study, feedback, who we are (with the final call to action in the same card), FAQ, footer.
// Every Home section is built. The footer sits outside the page ground so it stays flat.
import PageShell from "../layouts/PageShell.astro";
import SiteNav from "../components/SiteNav.astro";
import Hero from "../components/Hero.astro";
import Video from "../components/Video.astro";
import Services from "../components/Services.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Feedback from "../components/Feedback.astro";
import WhoWeAre from "../components/WhoWeAre.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
---

<PageShell title="Sortoise | Custom software for small businesses">
  <div class="page-ground">
    <div class="nav-wrap">
      <SiteNav />
    </div>
    <Hero />
    <Video poster="/images/video-poster.jpg" posterWebp="/images/video-poster.webp" />
    <Services />
    <CaseStudy />
    <Feedback />
    <WhoWeAre />
    <FAQ />
  </div>
  <!-- The footer sits outside the page-ground wrapper, so the tortoise pattern never shows behind it. -->
  <Footer />
</PageShell>

<style>
  .page-ground { width: 100%; min-height: 100vh; }
  .nav-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 20px 60px 0;
  }
  @media (max-width: 820px) {
    .nav-wrap { padding: 12px 16px 0; }
  }
</style>
