---
// The Terms and Conditions page. The words live in the sections list below, so the page can be
// reworded without touching the layout. LegalPage draws the card, the contents rail and the page.
import LegalPage from "../components/LegalPage.astro";

const sections = [
    {
      "heading": "Who we are",
      "paras": [
        "Sortoise is a small software workshop based in South Wales. Sortoise is a trading name used by Aaron Davies and Luke Jenkins, who run the business together in partnership. Sortoise is not a registered company, so there is no company number or registered office to give you. You can reach us at <a href=\"mailto:sortoisesolutions@gmail.com\">sortoisesolutions@gmail.com</a>, or by post at 17 Heol Beili Glas, Llanelli, SA14 8DT."
      ]
    },
    {
      "heading": "What these terms are for",
      "paras": [
        "These terms cover your use of this website. They are not the terms of any work we do for you. If you hire us, that work is covered by a separate written agreement that we both sign, and where the two documents disagree, that agreement wins.",
        "By using this site you accept these terms. If you do not accept them, please stop using the site."
      ]
    },
    {
      "heading": "What is on the site",
      "paras": [
        "Everything here is written to explain what we do and to help you decide whether to talk to us. It is general information, not advice for your particular business, and it is not an offer that you can accept to form a contract.",
