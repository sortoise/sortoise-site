---
// Case Study page, built 30 Sep 2026. Nav, a plain heading, then the two client stories
// with the client tabs (see CaseStudies.astro). The footer sits outside the page ground so it stays flat.
import PageShell from "../layouts/PageShell.astro";
import SiteNav from "../components/SiteNav.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Footer from "../components/Footer.astro";
---

<PageShell
  title="Case studies | Sortoise"
  description="How we have helped other businesses: the jobs that were eating their week, and the tools we built to take those jobs off their hands."
>
  <div class="page-ground">
    <div class="nav-wrap">
      <SiteNav />
    </div>
    <header class="head">
      <h1>How we have helped other businesses</h1>
      <p class="sub">
        Two businesses, the jobs that were eating their week, and the tools we built to take those
        jobs off their hands. Pick a client below to read the whole story.
      </p>
      <a class="note" href="/services">See what we build</a>
    </header>
    <section class="film" aria-label="Sortoise video">
      <div class="frame">
        <picture>
          <source srcset="/images/video-poster.webp" type="image/webp" />
          <img src="/images/video-poster.jpg" alt="Aaron at his desk, from the Sortoise video" width="1600" height="900" />
        </picture>
        <!-- Decorative until the real video exists: swap for a button and the embed when it does. -->
        <span class="play" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="#ffffff"><path d="M8 5l12 7-12 7z" /></svg>
        </span>
      </div>
    </section>
    <main>
      <CaseStudies />
    </main>
  </div>
  <!-- The footer sits outside the page-ground wrapper, so the tortoise pattern never shows behind it. -->
  <Footer />
</PageShell>

<style>
  .page-ground { width: 100%; min-height: 100vh; }
  .nav-wrap { max-width: 1240px; margin: 0 auto; padding: 20px 60px 0; }

  /* The heading takes the hero's job here. The stories section brings its own 96px on top,
     so this only adds 24px underneath, giving a 120px gap. */
  .head {
    padding: 72px 24px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .head h1 {
    margin: 0;
    max-width: 900px;
    font-size: 58px;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--deep-700);
  }
  .sub {
    margin: 0;
    max-width: 620px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-soft);
  }
  .note {
    font-size: 16px;
    color: var(--text-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .film { padding: 8px 24px 0; }
  .frame {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--deep-950);
  }
  .frame img { display: block; width: 100%; height: 100%; object-fit: cover; opacity: 0.86; }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 76px;
    height: 76px;
    border-radius: var(--radius-pill);
    background: var(--pink-500);
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 4px;
    box-shadow: var(--shadow-raised);
  }

  @media (max-width: 820px) {
    .nav-wrap { padding: 12px 16px 0; }
    .film { padding: 8px 16px 0; }
    .play { width: 58px; height: 58px; }
    .head { padding: 48px 16px 16px; gap: 18px; }
    .head h1 { font-size: 38px; }
    .sub { font-size: 17px; }
  }
</style>
