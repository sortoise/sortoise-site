---
// Case Study page, built 30 Sep 2026. Nav, a plain heading, then the two client stories
// with the client tabs (see CaseStudies.astro). The footer sits outside the page ground so it stays flat.
import PageShell from "../layouts/PageShell.astro";
import SiteNav from "../components/SiteNav.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Footer from "../components/Footer.astro";
---

<PageShell
  title="Case studies | Sortoise"
  description="How we have helped other businesses: the jobs that were eating their week, and the tools we built to take those jobs off their hands."
>
  <div class="page-ground">
    <div class="nav-wrap">
      <SiteNav />
    </div>
    <header class="head">
      <h1>How we have helped other businesses</h1>
    </header>
    <main>
      <CaseStudies />
    </main>
  </div>
  <!-- The footer sits outside the page-ground wrapper, so the tortoise pattern never shows behind it. -->
  <Footer />
</PageShell>

<style>
  .page-ground { width: 100%; min-height: 100vh; }
  .nav-wrap { max-width: 1240px; margin: 0 auto; padding: 20px 60px 0; }

  /* The heading takes the hero's job here: 104px underneath, then the section's own 96px on top. */
  .head { padding: 64px 24px 104px; text-align: center; }
  .head h1 {
    margin: 0 auto;
    max-width: 900px;
    font-size: 58px;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--deep-700);
  }

  @media (max-width: 820px) {
    .nav-wrap { padding: 12px 16px 0; }
    .head { padding: 40px 16px 72px; }
    .head h1 { font-size: 38px; }
  }
</style>
