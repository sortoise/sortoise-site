---
// Case Study page, built 30 Sep 2026. Nav, a plain heading, then the two client stories
// with the client tabs (see CaseStudies.astro). The footer sits outside the page ground so it stays flat.
import PageShell from "../layouts/PageShell.astro";
import SiteNav from "../components/SiteNav.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Footer from "../components/Footer.astro";
---

<PageShell
  title="Case studies | Sortoise"
  description="How we've helped two businesses: the jobs that were eating up their week, and what we built to take them off their hands."
>
  <div class="page-ground">
    <div class="nav-wrap">
      <SiteNav />
    </div>
    <header class="head">
      <h1>How we have helped other businesses</h1>
      <p class="sub">
        Here's what was eating up the week at two businesses, and what we built to take it off
        their hands. Pick a client below to read the full story.
      </p>
      <a class="note" href="/services">See what we build</a>
    </header>
    <section class="film" aria-label="Video of one of our tools">
      <!-- The same video as Home. The play button and the swap live in src/scripts/video-frame.ts. -->
      <div class="frame" data-video-frame data-src="/video/sortoise-demo.mp4" data-title="Sortoise invoicing tool, from the van to the desk">
        <picture>
          <source srcset="/images/video-poster.webp" type="image/webp" />
          <img src="/images/video-poster.jpg" alt="" width="1600" height="900" />
        </picture>
        <button type="button" class="play" data-play aria-label="Play the video">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true"><path d="M8 5l12 7-12 7z" /></svg>
        </button>
      </div>
    </section>
    <main>
      <CaseStudies />
    </main>
  </div>
  <!-- The footer sits outside the page-ground wrapper, so the tortoise pattern never shows behind it. -->
  <Footer />
</PageShell>

<script>
  import "../scripts/video-frame.ts";
</script>

<style>
  .page-ground { width: 100%; min-height: 100vh; }
  .nav-wrap { max-width: 1240px; margin: 0 auto; padding: 20px 60px 0; }

  /* The heading takes the hero's job here. The stories section brings its own 96px on top,
     so this only adds 24px underneath, giving a 120px gap. */
  .head {
    padding: 72px 24px 24px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .head h1 {
    margin: 0;
    max-width: 900px;
    font-size: 58px;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--deep-700);
  }
  .sub {
    margin: 0;
    max-width: 620px;
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-soft);
  }
  .note {
    font-size: 16px;
    color: var(--text-link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .film { padding: 8px 24px 0; }
  .frame {
    position: relative;
    max-width: 960px;
    margin: 0 auto;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-xl);
    overflow: hidden;
    background: var(--deep-950);
  }
  /* Full strength now the poster is a light still from the video itself. */
  .frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .frame :global(video), .frame :global(iframe) {
    position: absolute; inset: 0; width: 100%; height: 100%;
    border: 0; object-fit: contain; background: var(--deep-950);
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 76px;
    height: 76px;
    border-radius: var(--radius-pill);
    background: var(--pink-500);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 0 0 4px;
    border: 0;
    box-shadow: var(--shadow-raised);
    cursor: pointer;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .play:hover { background: var(--pink-400); }

  @media (max-width: 820px) {
    .nav-wrap { padding: 12px 16px 0; }
    .film { padding: 8px 16px 0; }
    .play { width: 58px; height: 58px; }
    .head { padding: 48px 16px 16px; gap: 18px; }
    .head h1 { font-size: 38px; }
    .sub { font-size: 17px; }
  }
</style>
